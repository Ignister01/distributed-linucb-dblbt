diff --git a/src/wifi/test/dblbt-hook-test.cc b/src/wifi/test/dblbt-hook-test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..781d3ffe978f4b9f69192968df9ffd9069453d06
--- /dev/null
+++ b/src/wifi/test/dblbt-hook-test.cc
@@ -0,0 +1,189 @@
+/* -*- Mode:C++; c-file-style:"gnu"; indent-tabs-mode:nil; -*- */
+
+#include "ns3/object.h"
+#include "ns3/channel-access-manager.h"
+#include "ns3/random-variable-stream.h"
+#include "ns3/rng-seed-manager.h"
+#include "ns3/simulator.h"
+#include "ns3/test.h"
+#include "ns3/txop.h"
+
+#include <vector>
+
+namespace ns3 {
+
+class DbLbtHookProbe : public Txop
+{
+public:
+  void DrawBackoff ()
+  {
+    GenerateBackoff ();
+  }
+
+  uint32_t BackoffSlots () const
+  {
+    return GetBackoffSlots ();
+  }
+
+  void RequestForTest ()
+  {
+    NotifyAccessRequested ();
+  }
+};
+
+class DbLbtChannelAccessManagerStub : public ChannelAccessManager
+{
+private:
+  Time GetSifs () const override
+  {
+    return MicroSeconds (16);
+  }
+
+  Time GetSlot () const override
+  {
+    return MicroSeconds (9);
+  }
+
+  Time GetEifsNoDifs () const override
+  {
+    return MicroSeconds (44);
+  }
+};
+
+class DbLbtHookTestCase : public TestCase
+{
+public:
+  DbLbtHookTestCase ()
+    : TestCase ("disabled DB-LBT hook preserves stock Txop traces")
+  {
+  }
+
+private:
+  uint32_t SelectBackoff (uint32_t cw)
+  {
+    m_selectedCw = cw;
+    return 17;
+  }
+
+  void Busy (Time duration)
+  {
+    ++m_busyCalls;
+    m_busyDuration += duration;
+  }
+
+  void Outcome (bool success)
+  {
+    m_outcomes.push_back (success);
+  }
+
+  void Granted (Time duration)
+  {
+    ++m_grantCalls;
+    m_grantDuration = duration;
+  }
+
+  void BackoffTrace (uint32_t value)
+  {
+    m_trace.push_back (value);
+  }
+
+  void DoRun () override
+  {
+    RngSeedManager::SetSeed (410);
+    RngSeedManager::SetRun (1);
+
+    Ptr<UniformRandomVariable> reference =
+      CreateObject<UniformRandomVariable> ();
+    reference->SetStream (73);
+    Ptr<DbLbtHookProbe> stock = CreateObject<DbLbtHookProbe> ();
+    stock->SetMinCw (15);
+    stock->SetMaxCw (15);
+    stock->AssignStreams (73);
+    stock->TraceConnectWithoutContext (
+      "BackoffTrace", MakeCallback (&DbLbtHookTestCase::BackoffTrace, this));
+
+    for (uint32_t draw = 0; draw < 128; ++draw)
+      {
+        uint32_t expected = reference->GetInteger (0, 15);
+        stock->DrawBackoff ();
+        NS_TEST_ASSERT_MSG_EQ (stock->BackoffSlots (), expected,
+                               "disabled hook changed stock backoff bytes");
+        NS_TEST_ASSERT_MSG_EQ (m_trace.at (draw), expected,
+                               "disabled hook changed stock trace bytes");
+      }
+
+    Ptr<DbLbtHookProbe> hooked = CreateObject<DbLbtHookProbe> ();
+    hooked->SetMinCw (15);
+    hooked->SetMaxCw (15);
+    hooked->SetAifsn (2);
+    hooked->SetDbLbtBackoffCallback (
+      MakeCallback (&DbLbtHookTestCase::SelectBackoff, this));
+    hooked->SetDbLbtBusyCallback (
+      MakeCallback (&DbLbtHookTestCase::Busy, this));
+    hooked->SetDbLbtOutcomeCallback (
+      MakeCallback (&DbLbtHookTestCase::Outcome, this));
+    hooked->SetDbLbtGrantCallback (
+      MakeCallback (&DbLbtHookTestCase::Granted, this));
+    hooked->DrawBackoff ();
+    NS_TEST_ASSERT_MSG_EQ (hooked->BackoffSlots (), 17,
+                           "hook did not supply the selected backoff");
+    NS_TEST_ASSERT_MSG_EQ (m_selectedCw, 15,
+                           "hook did not receive the current CW");
+
+    Ptr<ChannelAccessManager> manager =
+      CreateObject<DbLbtChannelAccessManagerStub> ();
+    hooked->SetChannelAccessManager (manager);
+    hooked->RequestForTest ();
+    manager->NotifyMaybeCcaBusyStartNow (MicroSeconds (20));
+    manager->NotifyMaybeCcaBusyStartNow (MicroSeconds (30));
+    NS_TEST_ASSERT_MSG_EQ (m_busyCalls, 1,
+                           "overlapping CCA reports duplicated a busy period");
+    Simulator::Schedule (
+      MicroSeconds (31),
+      &ChannelAccessManager::NotifyMaybeCcaBusyStartNow,
+      manager,
+      MicroSeconds (10));
+    Simulator::Run ();
+    NS_TEST_ASSERT_MSG_EQ (m_busyCalls, 2,
+                           "a later busy period was not reported");
+    NS_TEST_ASSERT_MSG_EQ (m_busyDuration, MicroSeconds (30),
+                           "busy callback did not preserve first durations");
+
+    hooked->UpdateFailedCw ();
+    hooked->ResetCw ();
+    NS_TEST_ASSERT_MSG_EQ (m_outcomes.size (), 2,
+                           "outcome callbacks were not emitted once each");
+    NS_TEST_ASSERT_MSG_EQ (m_outcomes.at (0), false,
+                           "failed CW update was not reported as failure");
+    NS_TEST_ASSERT_MSG_EQ (m_outcomes.at (1), true,
+                           "CW reset was not reported as success");
+    hooked->NotifyChannelAccessed (MicroSeconds (123));
+    NS_TEST_ASSERT_MSG_EQ (m_grantCalls, 1,
+                           "grant callback was not emitted once");
+    NS_TEST_ASSERT_MSG_EQ (m_grantDuration, MicroSeconds (123),
+                           "grant callback changed the duration");
+    Simulator::Destroy ();
+  }
+
+  uint32_t m_selectedCw {0};
+  uint32_t m_busyCalls {0};
+  uint32_t m_grantCalls {0};
+  Time m_busyDuration {Seconds (0)};
+  Time m_grantDuration {Seconds (0)};
+  std::vector<bool> m_outcomes;
+  std::vector<uint32_t> m_trace;
+};
+
+class DbLbtHookTestSuite : public TestSuite
+{
+public:
+  DbLbtHookTestSuite ()
+    : TestSuite ("dblbt-hook", UNIT)
+  {
+    AddTestCase (new DbLbtHookTestCase, TestCase::QUICK);
+  }
+};
+
+static DbLbtHookTestSuite g_dbLbtHookTestSuite;
+
+} // namespace ns3
