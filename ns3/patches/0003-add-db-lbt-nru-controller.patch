@@ -0,0 +1,145 @@
+/* -*- Mode:C++; c-file-style:"gnu"; indent-tabs-mode:nil; -*- */
+
+#ifndef DB_LBT_LOCAL_CONTROLLER_H
+#define DB_LBT_LOCAL_CONTROLLER_H
+
+#include "ns3/nstime.h"
+#include "ns3/object.h"
+#include "ns3/random-variable-stream.h"
+
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <vector>
+
+namespace ns3 {
+
+class DbLbtLocalController : public Object
+{
+public:
+  static constexpr uint32_t NumArms = 24;
+  static constexpr uint32_t ContextDim = 11;
+  static constexpr uint32_t ColdStartAttempts = 8;
+  static constexpr uint32_t DecisionInterval = 32;
+
+  struct RecoveryProfile
+  {
+    uint32_t kappa {7};
+    uint32_t alpha {11};
+    uint32_t beta {3};
+    uint32_t m {6};
+    uint32_t bInit {15};
+
+    bool operator== (const RecoveryProfile &other) const;
+  };
+
+  struct AttemptRecord
+  {
+    bool success {false};
+    double elapsedUs {0.0};
+    double busyUs {0.0};
+    uint32_t interruptions {0};
+    double accessDelayUs {0.0};
+    double queueOccupancy {0.0};
+    uint32_t arrivals {0};
+    uint32_t retries {0};
+    double effectiveDataUs {0.0};
+    uint32_t selectedBackoff {0};
+  };
+
+  struct DecisionRecord
+  {
+    uint64_t attemptId {0};
+    uint32_t armId {0};
+    RecoveryProfile profile;
+    std::array<double, ContextDim> context {};
+    double reward {0.0};
+  };
+
+  static TypeId GetTypeId ();
+  DbLbtLocalController ();
+
+  static std::vector<RecoveryProfile> Profiles ();
+
+  void ConfigureTmc ();
+  void ConfigureAdaptive (const std::string &modelPath,
+                          const std::string &expectedModelHash,
+                          const std::string &expectedGridHash);
+  int64_t AssignStreams (int64_t stream);
+
+  uint32_t NextBackoff (uint32_t currentCw);
+  void NotifyBusy (Time duration);
+  void NotifyGrant (Time duration);
+  void NotifyOwnTx (Time duration);
+  void NotifyArrival (uint32_t count = 1);
+  void SetQueueOccupancy (double ratio);
+  void NotifyOutcome (bool success);
+  void RecordAttempt (const AttemptRecord &attempt);
+
+  uint32_t GetAlpha () const;
+  const std::string &GetStateId () const;
+  const RecoveryProfile &GetCurrentProfile () const;
+  const std::vector<DecisionRecord> &GetDecisions () const;
+  const std::vector<AttemptRecord> &GetAttempts () const;
+
+private:
+  using Context = std::array<double, ContextDim>;
+  using Matrix = std::array<Context, ContextDim>;
+
+  struct ArmState
+  {
+    Matrix A {};
+    Context b {};
+  };
+
+  enum class Policy
+  {
+    Unconfigured,
+    Tmc,
+    Adaptive
+  };
+
+  void LoadModel (const std::string &modelPath,
+                  const std::string &expectedModelHash,
+                  const std::string &expectedGridHash);
+  void Decide ();
+  Context BuildContext () const;
+  double IntervalReward (const Context &context) const;
+  uint32_t SelectArm (const Context &context) const;
+  void UpdateArm (uint32_t arm, const Context &context, double reward);
+  static Context Solve (const Matrix &matrix, const Context &rightHandSide);
+  static double Clip (double value);
+
+  Policy m_policy {Policy::Unconfigured};
+  Ptr<UniformRandomVariable> m_rng;
+  std::string m_stateId;
+  std::string m_modelHash;
+  std::string m_gridHash;
+  double m_exploration {0.5};
+  std::array<ArmState, NumArms> m_model {};
+  RecoveryProfile m_profile;
+  bool m_initialized {false};
+  uint32_t m_retries {0};
+  uint32_t m_interruptions {0};
+  uint32_t m_selectedBackoff {0};
+  uint32_t m_pendingArrivals {0};
+  double m_queueOccupancy {1.0};
+  double m_attemptBusyUs {0.0};
+  double m_attemptEffectiveDataUs {0.0};
+  double m_attemptAccessDelayUs {0.0};
+  Time m_lastAttemptEnd {Seconds (0)};
+  Time m_attemptStart {Seconds (0)};
+  bool m_attemptActive {false};
+  uint64_t m_attemptCount {0};
+  int32_t m_currentArm {-1};
+  Context m_decisionContext {};
+  std::deque<AttemptRecord> m_window;
+  std::vector<AttemptRecord> m_interval;
+  std::vector<AttemptRecord> m_attempts;
+  std::vector<DecisionRecord> m_decisions;
+};
+
+} // namespace ns3
+
+#endif // DB_LBT_LOCAL_CONTROLLER_H
