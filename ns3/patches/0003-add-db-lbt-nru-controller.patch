+
+namespace ns3 {
+
+class NrDbLbtAccessManagerProbe : public NrDbLbtAccessManager
+{
+public:
+  uint32_t DrawBackoff ()
+  {
+    return GetBackoffSlots ();
+  }
+
+  LbtState State () const
+  {
+    return GetLbtState ();
+  }
+
+  uint32_t RemainingBackoff () const
+  {
+    return GetCurrentBackoffCount ();
+  }
+
+  void ArmStaleAccessTimers ()
+  {
+    SetLbtState (WAIT_FOR_BACKOFF);
+    m_waitForDeferEventId = Simulator::Schedule (
+      Seconds (1), &NrDbLbtAccessManagerProbe::FireDefer, this);
+    m_waitForBackoffEventId = Simulator::Schedule (
+      Seconds (1), &NrDbLbtAccessManagerProbe::FireBackoff, this);
+  }
+
+  void Grant ()
+  {
+    SetGrant ();
+  }
+
+  bool DeferTimerRunning () const
+  {
+    return m_waitForDeferEventId.IsRunning ();
+  }
+
+  bool BackoffTimerRunning () const
+  {
+    return m_waitForBackoffEventId.IsRunning ();
+  }
+
+  void EnterBackoffAndFireStaleDefer ()
+  {
+    m_backoffCount = 11;
+    SetLbtState (WAIT_FOR_BACKOFF);
+    RequestAccessAfterDefer ();
+  }
+
+private:
+  void FireDefer ()
+  {
+    RequestAccessAfterDefer ();
+  }
+
+  void FireBackoff ()
+  {
+    RequestAccessAfterBackoff ();
+  }
+};
+
+class DbLbtControllerTestCase : public TestCase
+{
+public:
+  DbLbtControllerTestCase ()
+    : TestCase ("local DB-LBT controller preserves the frozen contract")
+  {
+  }
+
+private:
+  static std::string WriteModel ()
+  {
+    const std::string path = "/tmp/ns3-dblbt-controller-model.txt";
+    std::ofstream output (path, std::ios::out | std::ios::trunc);
+    output << "dblbt_ns3_model 1\n"
+           << "schema_version 1\n"
+           << "num_arms 24\n"
+           << "context_dim 11\n"
+           << "ridge 1\n"
+           << "exploration 0.5\n"
+           << "action_grid_hash "
+           << "558da7340dfa32d8cc484ba68a05951314936d7aff34a145cc34ea051c07707c\n"
+           << "source_model_sha256 " << std::string (64, 'a') << "\n"
+           << "profiles 24\n";
+    uint32_t arm = 0;
+    for (uint32_t kappa : {5u, 7u})
+      {
+        for (uint32_t beta : {2u, 3u})
+          {
+            for (uint32_t m : {4u, 6u, 10u})
+              {
+                for (uint32_t initial : {15u, 31u})
+                  {
+                    output << "profile " << arm++ << " " << kappa
+                           << " 11 " << beta << " " << m << " "
+                           << initial << "\n";
+                  }
+              }
+          }
+      }
+    output << "A_rows 264\n";
+    for (uint32_t modelArm = 0; modelArm < 24; ++modelArm)
+      {
+        for (uint32_t row = 0; row < 11; ++row)
+          {
+            output << "A " << modelArm << " " << row;
+            for (uint32_t column = 0; column < 11; ++column)
+              {
+                output << " " << (row == column ? 1 : 0);
+              }
+            output << "\n";
+          }
+      }
+    output << "b_rows 24\n";
+    for (uint32_t modelArm = 0; modelArm < 24; ++modelArm)
+      {
+        output << "b " << modelArm;
+        for (uint32_t column = 0; column < 11; ++column)
+          {
+            output << " 0";
+          }
+        output << "\n";
+      }
+    output << "end\n";
+    output.close ();
+    return path;
+  }
+
+  static DbLbtLocalController::AttemptRecord Attempt (bool success)
+  {
+    DbLbtLocalController::AttemptRecord attempt;
+    attempt.success = success;
+    attempt.elapsedUs = 1000.0;
+    attempt.busyUs = 200.0;
+    attempt.interruptions = 1;
+    attempt.accessDelayUs = 300.0;
+    attempt.queueOccupancy = 0.5;
+    attempt.arrivals = 1;
+    attempt.retries = success ? 0 : 1;
+    attempt.effectiveDataUs = success ? 700.0 : 0.0;
+    attempt.selectedBackoff = 11;
+    return attempt;
+  }
+
+  void DoRun () override
+  {
+    const std::string modelPath = WriteModel ();
+    const std::string modelHash (64, 'a');
+    const std::string gridHash =
+      "558da7340dfa32d8cc484ba68a05951314936d7aff34a145cc34ea051c07707c";
+
+    auto profiles = DbLbtLocalController::Profiles ();
+    NS_TEST_ASSERT_MSG_EQ (profiles.size (), 24,
+                           "adaptive grid does not contain 24 arms");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (0).kappa, 5,
+                           "first arm kappa changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (0).alpha, 11,
+                           "first arm alpha changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (0).beta, 2,
+                           "first arm beta changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (0).m, 4,
+                           "first arm m changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (0).bInit, 15,
+                           "first arm initial range changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (23).kappa, 7,
+                           "last arm kappa changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (23).beta, 3,
+                           "last arm beta changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (23).m, 10,
+                           "last arm m changed");
+    NS_TEST_ASSERT_MSG_EQ (profiles.at (23).bInit, 31,
+                           "last arm initial range changed");
+
+    Ptr<DbLbtLocalController> first = CreateObject<DbLbtLocalController> ();
+    Ptr<DbLbtLocalController> second = CreateObject<DbLbtLocalController> ();
+    first->ConfigureAdaptive (modelPath, modelHash, gridHash);
+    second->ConfigureAdaptive (modelPath, modelHash, gridHash);
+    NS_TEST_ASSERT_MSG_NE (first->GetStateId (), second->GetStateId (),
+                           "nodes share one adaptive state id");
+    NS_TEST_ASSERT_MSG_EQ (first->GetAlpha (), 11,
+                           "adaptive alpha is not fixed at 11");
+
+    for (uint32_t attempt = 0; attempt < 7; ++attempt)
+      {
+        first->RecordAttempt (Attempt (true));
+      }
+    NS_TEST_ASSERT_MSG_EQ (first->GetDecisions ().size (), 0,
+                           "decision occurred before eight own attempts");
+    for (uint32_t attempt = 7; attempt < 31; ++attempt)
+      {
+        first->RecordAttempt (Attempt (attempt % 5 != 0));
+      }
+    NS_TEST_ASSERT_MSG_EQ (first->GetDecisions ().size (), 0,
+                           "decision occurred before interval 32");
+    first->RecordAttempt (Attempt (true));
+    NS_TEST_ASSERT_MSG_EQ (first->GetDecisions ().size (), 1,
+                           "decision did not occur at own attempt 32");
+    const auto &decision = first->GetDecisions ().front ();
+    NS_TEST_ASSERT_MSG_EQ (decision.attemptId, 32,
+                           "decision boundary is not attempt 32");
+    NS_TEST_ASSERT_MSG_EQ (decision.armId, 0,
+                           "LinUCB tie did not choose the lowest arm");
+    NS_TEST_ASSERT_MSG_EQ (decision.profile.alpha, 11,
+                           "selected profile changed alpha");
+    NS_TEST_ASSERT_MSG_EQ (decision.context.size (), 11,
+                           "context does not contain exactly 11 fields");
+    NS_TEST_ASSERT_MSG_EQ (second->GetDecisions ().size (), 0,
+                           "one node mutated another node's model state");
+
+    Ptr<DbLbtLocalController> tmc = CreateObject<DbLbtLocalController> ();
+    tmc->ConfigureTmc ();
+    tmc->AssignStreams (91);
+    uint32_t initial = tmc->NextBackoff (15);
+    NS_TEST_ASSERT_MSG_EQ ((initial <= 15), true,
+                           "TMC initial backoff exceeded inclusive range");
+    tmc->RecordAttempt (Attempt (true));
+    tmc->NotifyBusy (MicroSeconds (20));
+    tmc->NotifyBusy (MicroSeconds (30));
+    NS_TEST_ASSERT_MSG_EQ (tmc->NextBackoff (15), 13,
+                           "TMC deterministic recovery is not alpha plus interruptions");
+    NS_TEST_ASSERT_MSG_EQ (tmc->GetCurrentProfile ().kappa, 7,
+                           "fixed TMC kappa changed");
+    NS_TEST_ASSERT_MSG_EQ (tmc->GetCurrentProfile ().beta, 3,
+                           "fixed TMC beta changed");
+    NS_TEST_ASSERT_MSG_EQ (tmc->GetCurrentProfile ().m, 6,
+                           "fixed TMC random range changed");
+
+    Ptr<DbLbtLocalController> traced = CreateObject<DbLbtLocalController> ();
+    traced->ConfigureTmc ();
+    traced->AssignStreams (92);
+    traced->NotifyOutcome (true);
+    NS_TEST_ASSERT_MSG_EQ (traced->GetAttempts ().size (), 0,
+                           "idle CW reset fabricated a local attempt");
+    traced->SetQueueOccupancy (0.75);
+    traced->NotifyArrival (3);
+    uint32_t selected = traced->NextBackoff (15);
+    Simulator::Schedule (MicroSeconds (10),
+                         &DbLbtLocalController::NotifyBusy,
+                         traced, MicroSeconds (20));
+    Simulator::Schedule (MicroSeconds (40),
+                         &DbLbtLocalController::NotifyGrant,
+                         traced, MicroSeconds (50));
+    Simulator::Schedule (MicroSeconds (50),
+                         &DbLbtLocalController::NotifyOwnTx,
+                         traced, MicroSeconds (50));
+    Simulator::Schedule (MicroSeconds (100),
+                         &DbLbtLocalController::NotifyOutcome,
+                         traced, true);
+    Simulator::Run ();
+    NS_TEST_ASSERT_MSG_EQ (traced->GetAttempts ().size (), 1,
+                           "trace callbacks did not form one own attempt");
+    const auto &observed = traced->GetAttempts ().front ();
+    NS_TEST_ASSERT_MSG_EQ_TOL (observed.elapsedUs, 100.0, 1e-12,
+                               "attempt elapsed time used non-local time");
+    NS_TEST_ASSERT_MSG_EQ_TOL (observed.busyUs, 20.0, 1e-12,
+                               "busy time did not come from local callback");
+    NS_TEST_ASSERT_MSG_EQ (observed.interruptions, 1,
+                           "busy callback did not count one interruption");
+    NS_TEST_ASSERT_MSG_EQ_TOL (observed.accessDelayUs, 40.0, 1e-12,
+                               "grant time did not form local access delay");
+    NS_TEST_ASSERT_MSG_EQ_TOL (observed.queueOccupancy, 0.75, 1e-12,
+                               "queue occupancy was not node local");
+    NS_TEST_ASSERT_MSG_EQ (observed.arrivals, 3,
+                           "arrival count was not node local");
+    NS_TEST_ASSERT_MSG_EQ_TOL (observed.effectiveDataUs, 50.0, 1e-12,
+                               "own PHY airtime was not recorded");
+    NS_TEST_ASSERT_MSG_EQ (observed.selectedBackoff, selected,
+                           "selected backoff was not bound to its attempt");
+    Simulator::Destroy ();
+
+    Ptr<NrDbLbtAccessManagerProbe> nrAdaptive =
+      CreateObject<NrDbLbtAccessManagerProbe> ();
+    nrAdaptive->SetAttribute ("Policy", StringValue ("adaptive"));
+    nrAdaptive->SetAttribute ("ModelPath", StringValue (modelPath));
+    nrAdaptive->SetAttribute ("ModelSha256", StringValue (modelHash));
+    nrAdaptive->SetAttribute ("ActionGridHash", StringValue (gridHash));
+    nrAdaptive->Initialize ();
+    NS_TEST_ASSERT_MSG_EQ (nrAdaptive->State (), NrLbtAccessManager::IDLE,
+                           "NR DB-LBT state was not initialized to IDLE");
+    NS_TEST_ASSERT_MSG_EQ (nrAdaptive->RemainingBackoff (), 0,
+                           "NR DB-LBT remaining backoff was not initialized");
+    NS_TEST_ASSERT_MSG_EQ (nrAdaptive->GetAlpha (), 11,
+                           "NR DB-LBT alpha is not fixed at 11");
+    NS_TEST_ASSERT_MSG_EQ ((nrAdaptive->DrawBackoff () <= 15), true,
+                           "NR manager did not delegate initial backoff");
+
+    Ptr<NrDbLbtAccessManagerProbe> nrSecond =
+      CreateObject<NrDbLbtAccessManagerProbe> ();
+    nrSecond->SetAttribute ("Policy", StringValue ("tmc"));
+    nrSecond->Initialize ();
+    NS_TEST_ASSERT_MSG_NE (
+      nrAdaptive->GetController ()->GetStateId (),
+      nrSecond->GetController ()->GetStateId (),
+      "NR gNBs share one controller state");
+
+    Ptr<NrDbLbtAccessManagerProbe> nrTimer =
+      CreateObject<NrDbLbtAccessManagerProbe> ();
+    nrTimer->SetAttribute ("Policy", StringValue ("tmc"));
+    nrTimer->Initialize ();
+    nrTimer->ArmStaleAccessTimers ();
+    NS_TEST_ASSERT_MSG_EQ (nrTimer->DeferTimerRunning (), true,
+                           "test did not arm the stale defer timer");
+    NS_TEST_ASSERT_MSG_EQ (nrTimer->BackoffTimerRunning (), true,
+                           "test did not arm the stale backoff timer");
+    nrTimer->Grant ();
+    NS_TEST_ASSERT_MSG_EQ (nrTimer->DeferTimerRunning (), false,
+                           "grant left a stale defer timer running");
+    NS_TEST_ASSERT_MSG_EQ (nrTimer->BackoffTimerRunning (), false,
+                           "grant left a stale backoff timer running");
+    Simulator::Destroy ();
+
+    Ptr<NrDbLbtAccessManagerProbe> nrStaleDefer =
+      CreateObject<NrDbLbtAccessManagerProbe> ();
+    nrStaleDefer->SetAttribute ("Policy", StringValue ("tmc"));
+    nrStaleDefer->Initialize ();
+    nrStaleDefer->EnterBackoffAndFireStaleDefer ();
+    NS_TEST_ASSERT_MSG_EQ (nrStaleDefer->State (),
+                           NrLbtAccessManager::WAIT_FOR_BACKOFF,
+                           "stale defer callback replaced active backoff state");
+    NS_TEST_ASSERT_MSG_EQ (nrStaleDefer->DeferTimerRunning (), false,
+                           "stale defer callback scheduled another defer timer");
+    Simulator::Destroy ();
+
+    std::remove (modelPath.c_str ());
+  }
+};
+
+class DbLbtControllerTestSuite : public TestSuite
+{
+public:
+  DbLbtControllerTestSuite ()
+    : TestSuite ("db-lbt-controller", UNIT)
+  {
+    AddTestCase (new DbLbtControllerTestCase, TestCase::QUICK);
+  }
+};
+
+static DbLbtControllerTestSuite g_dbLbtControllerTestSuite;
+
+} // namespace ns3
