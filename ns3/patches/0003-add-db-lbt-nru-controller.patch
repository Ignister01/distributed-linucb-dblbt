+void
+WifiPhyState (Ptr<DbLbtLocalController> controller,
+              Time start,
+              Time duration,
+              WifiPhyState state)
+{
+  NS_UNUSED (start);
+  if (state == WifiPhyState::TX)
+    {
+      controller->NotifyOwnTx (duration);
+    }
+}
