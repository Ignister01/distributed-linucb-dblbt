+struct OccupancyTracker
+{
+  Time end {Seconds (0)};
+  Time total {Seconds (0)};
+
+  bool Active () const
+  {
+    return end > Simulator::Now ();
+  }
+
+  void Observe (Time duration)
+  {
+    Time now = Simulator::Now ();
+    Time nextEnd = now + duration;
+    if (now >= end)
+      {
+        total += duration;
+      }
+    else if (nextEnd > end)
+      {
+        total += nextEnd - end;
+      }
+    end = std::max (end, nextEnd);
+  }
+};
