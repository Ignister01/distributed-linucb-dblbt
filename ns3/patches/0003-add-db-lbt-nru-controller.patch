+/* -*- Mode:C++; c-file-style:"gnu"; indent-tabs-mode:nil; -*- */
+
+#include "nr-db-lbt-access-manager.h"
+
+#include "ns3/abort.h"
+#include "ns3/log.h"
+#include "ns3/simulator.h"
+#include "ns3/string.h"
+#include "ns3/uinteger.h"
+
+#include <algorithm>
+
+namespace ns3 {
+
+NS_LOG_COMPONENT_DEFINE ("NrDbLbtAccessManager");
+NS_OBJECT_ENSURE_REGISTERED (NrDbLbtAccessManager);
+
+TypeId
+NrDbLbtAccessManager::GetTypeId ()
+{
+  static TypeId tid = TypeId ("ns3::NrDbLbtAccessManager")
+    .SetParent<NrLbtAccessManager> ()
+    .SetGroupName ("nr-u")
+    .AddConstructor<NrDbLbtAccessManager> ()
+    .AddAttribute ("Alpha",
+                   "Fixed deterministic backoff base; only 11 is valid.",
+                   UintegerValue (11),
+                   MakeUintegerAccessor (&NrDbLbtAccessManager::SetAlpha,
+                                         &NrDbLbtAccessManager::GetAlpha),
+                   MakeUintegerChecker<uint32_t> (11, 11))
+    .AddAttribute ("Policy",
+                   "DB-LBT policy: tmc or adaptive.",
+                   StringValue ("tmc"),
+                   MakeStringAccessor (&NrDbLbtAccessManager::m_policy),
+                   MakeStringChecker ())
+    .AddAttribute ("ModelPath",
+                   "Strict ASCII LinUCB model path for adaptive mode.",
+                   StringValue (""),
+                   MakeStringAccessor (&NrDbLbtAccessManager::m_modelPath),
+                   MakeStringChecker ())
+    .AddAttribute ("ModelSha256",
+                   "SHA-256 of the source fixed LinUCB NPZ.",
+                   StringValue (""),
+                   MakeStringAccessor (&NrDbLbtAccessManager::m_modelSha256),
+                   MakeStringChecker ())
+    .AddAttribute ("ActionGridHash",
+                   "SHA-256 of the preregistered 24-arm grid.",
+                   StringValue (
+                     "558da7340dfa32d8cc484ba68a05951314936d7aff34a145cc34ea051c07707c"),
+                   MakeStringAccessor (&NrDbLbtAccessManager::m_actionGridHash),
+                   MakeStringChecker ())
+    .AddTraceSource ("SelectedBackoff",
+                     "Backoff selected by this gNB's local state.",
+                     MakeTraceSourceAccessor (
+                       &NrDbLbtAccessManager::m_selectedBackoffTrace),
+                     "ns3::TracedCallback::Uint32Callback")
+    .AddTraceSource ("Interruption",
+                     "One notification for a local busy-period interruption.",
+                     MakeTraceSourceAccessor (
+                       &NrDbLbtAccessManager::m_interruptionTrace),
+                     "ns3::TracedCallback::Uint32Callback")
+    .AddTraceSource ("Outcome",
+                     "Local DL HARQ outcome for the pending access attempt.",
+                     MakeTraceSourceAccessor (&NrDbLbtAccessManager::m_outcomeTrace),
+                     "ns3::TracedCallback::BoolCallback");
+  return tid;
+}
+
+NrDbLbtAccessManager::NrDbLbtAccessManager ()
+  : m_controller (CreateObject<DbLbtLocalController> ())
+{
+}
+
+void
+NrDbLbtAccessManager::SetNrGnbMac (Ptr<NrGnbMac> mac)
+{
+  NrLbtAccessManager::SetNrGnbMac (mac);
+  GetNrGnbMac ()->TraceConnectWithoutContext (
+    "DlHarqFeedback",
+    MakeCallback (&NrDbLbtAccessManager::ObserveHarq, this));
+}
+
+int64_t
+NrDbLbtAccessManager::AssignStreams (int64_t stream)
+{
+  NrLbtAccessManager::AssignStreams (stream);
+  m_controller->AssignStreams (stream + 1);
+  return 2;
+}
+
+uint32_t
+NrDbLbtAccessManager::GetAlpha () const
+{
+  return m_alpha;
+}
+
+Ptr<DbLbtLocalController>
+NrDbLbtAccessManager::GetController () const
+{
+  return m_controller;
+}
+
+void
+NrDbLbtAccessManager::NotifyOwnTx (Time duration)
+{
+  if (m_attemptPending)
+    {
+      m_controller->NotifyOwnTx (duration);
+    }
+}
+
+void
+NrDbLbtAccessManager::DoInitialize ()
+{
+  NS_ABORT_MSG_IF (m_alpha != 11, "NR DB-LBT alpha must be exactly 11");
+  SetLbtState (IDLE);
+  m_backoffCount = 0;
+  if (m_policy == "tmc")
+    {
+      m_controller->ConfigureTmc ();
+    }
+  else if (m_policy == "adaptive")
+    {
+      NS_ABORT_MSG_IF (m_modelPath.empty () || m_modelSha256.empty (),
+                       "adaptive NR DB-LBT requires a fixed model and hash");
+      m_controller->ConfigureAdaptive (
+        m_modelPath, m_modelSha256, m_actionGridHash);
+    }
+  else
+    {
+      NS_ABORT_MSG ("unsupported NR DB-LBT policy " << m_policy);
+    }
+  NrLbtAccessManager::DoInitialize ();
+}
+
+uint32_t
+NrDbLbtAccessManager::GetBackoffSlots ()
+{
+  uint32_t selected = m_controller->NextBackoff (0);
+  m_attemptPending = true;
+  m_selectedBackoffTrace (selected);
+  return selected;
+}
+
+void
+NrDbLbtAccessManager::TransitionToBusy (Time duration)
+{
+  Time now = Simulator::Now ();
+  if (m_attemptPending && now >= m_reportedBusyEnd)
+    {
+      m_controller->NotifyBusy (duration);
+      m_interruptionTrace (1);
+    }
+  m_reportedBusyEnd = std::max (m_reportedBusyEnd, now + duration);
+  NrLbtAccessManager::TransitionToBusy (duration);
+}
+
+void
+NrDbLbtAccessManager::RequestAccessAfterDefer ()
+{
+  if (GetLbtState () != WAIT_FOR_DEFER)
+    {
+      return;
+    }
+  NrLbtAccessManager::RequestAccessAfterDefer ();
+}
+
+void
+NrDbLbtAccessManager::SetGrant ()
+{
+  if (m_waitForDeferEventId.IsRunning ())
+    {
+      m_waitForDeferEventId.Cancel ();
+    }
+  if (m_waitForBackoffEventId.IsRunning ())
+    {
+      m_waitForBackoffEventId.Cancel ();
+    }
+  if (m_attemptPending)
+    {
+      m_controller->NotifyGrant (GetMcot ());
+    }
+  NrLbtAccessManager::SetGrant ();
+}
+
+void
+NrDbLbtAccessManager::SetAlpha (uint32_t alpha)
+{
+  NS_ABORT_MSG_IF (alpha != 11, "NR DB-LBT alpha must be exactly 11");
+  m_alpha = alpha;
+}
+
+void
+NrDbLbtAccessManager::ObserveHarq (const DlHarqInfo &feedback)
+{
+  if (!m_attemptPending)
+    {
+      return;
+    }
+  bool success = feedback.IsReceivedOk ();
+  m_controller->NotifyOutcome (success);
+  m_outcomeTrace (success);
+  m_attemptPending = false;
+}
+
+} // namespace ns3
