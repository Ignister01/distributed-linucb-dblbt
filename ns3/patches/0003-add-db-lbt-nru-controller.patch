diff --git a/model/db-lbt-local-controller.cc b/model/db-lbt-local-controller.cc
new file mode 100644
index 0000000..53b14ac
--- /dev/null
+++ b/model/db-lbt-local-controller.cc
@@ -0,0 +1,651 @@
+/* -*- Mode:C++; c-file-style:"gnu"; indent-tabs-mode:nil; -*- */
+
+#include "db-lbt-local-controller.h"
+
+#include "ns3/abort.h"
+#include "ns3/log.h"
+#include "ns3/simulator.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <fstream>
+#include <limits>
+#include <numeric>
+#include <sstream>
+#include <stdexcept>
+
+namespace ns3 {
+
+NS_LOG_COMPONENT_DEFINE ("DbLbtLocalController");
+NS_OBJECT_ENSURE_REGISTERED (DbLbtLocalController);
+
+namespace {
+
+const char *g_gridHash =
+  "558da7340dfa32d8cc484ba68a05951314936d7aff34a145cc34ea051c07707c";
+std::atomic<uint64_t> g_nextStateId {0};
+
+void
+RequireToken (std::istream &input, const std::string &expected)
+{
+  std::string actual;
+  input >> actual;
+  if (!input || actual != expected)
+    {
+      throw std::runtime_error ("expected model token " + expected);
+    }
+}
+
+uint32_t
+ReadUint (std::istream &input, const std::string &name)
+{
+  uint32_t value;
+  input >> value;
+  if (!input)
+    {
+      throw std::runtime_error ("invalid model integer " + name);
+    }
+  return value;
+}
+
+double
+ReadDouble (std::istream &input, const std::string &name)
+{
+  double value;
+  input >> value;
+  if (!input || !std::isfinite (value))
+    {
+      throw std::runtime_error ("invalid model number " + name);
+    }
+  return value;
+}
+
+} // namespace
+
+bool
+DbLbtLocalController::RecoveryProfile::operator== (
+  const RecoveryProfile &other) const
+{
+  return kappa == other.kappa && alpha == other.alpha &&
+         beta == other.beta && m == other.m && bInit == other.bInit;
+}
+
+TypeId
+DbLbtLocalController::GetTypeId ()
+{
+  static TypeId tid = TypeId ("ns3::DbLbtLocalController")
+    .SetParent<Object> ()
+    .SetGroupName ("nr-u")
+    .AddConstructor<DbLbtLocalController> ();
+  return tid;
+}
+
+DbLbtLocalController::DbLbtLocalController ()
+  : m_rng (CreateObject<UniformRandomVariable> ())
+{
+  m_stateId = "dblbt-state-" + std::to_string (++g_nextStateId);
+}
+
+std::vector<DbLbtLocalController::RecoveryProfile>
+DbLbtLocalController::Profiles ()
+{
+  std::vector<RecoveryProfile> profiles;
+  profiles.reserve (NumArms);
+  for (uint32_t kappa : {5u, 7u})
+    {
+      for (uint32_t beta : {2u, 3u})
+        {
+          for (uint32_t m : {4u, 6u, 10u})
+            {
+              for (uint32_t initial : {15u, 31u})
+                {
+                  profiles.push_back ({kappa, 11, beta, m, initial});
+                }
+            }
+        }
+    }
+  return profiles;
+}
+
+void
+DbLbtLocalController::ConfigureTmc ()
+{
+  m_policy = Policy::Tmc;
+  m_profile = {7, 11, 3, 6, 15};
+  m_lastAttemptEnd = Simulator::Now ();
+}
+
+void
+DbLbtLocalController::ConfigureAdaptive (
+  const std::string &modelPath,
+  const std::string &expectedModelHash,
+  const std::string &expectedGridHash)
+{
+  LoadModel (modelPath, expectedModelHash, expectedGridHash);
+  m_policy = Policy::Adaptive;
+  m_profile = {7, 11, 3, 6, 15};
+  m_lastAttemptEnd = Simulator::Now ();
+}
+
+int64_t
+DbLbtLocalController::AssignStreams (int64_t stream)
+{
+  m_rng->SetStream (stream);
+  return 1;
+}
+
+uint32_t
+DbLbtLocalController::NextBackoff (uint32_t currentCw)
+{
+  NS_UNUSED (currentCw);
+  NS_ABORT_MSG_IF (m_policy == Policy::Unconfigured,
+                   "DB-LBT controller is not configured");
+  uint32_t selected;
+  if (!m_initialized)
+    {
+      selected = m_rng->GetInteger (0, m_profile.bInit);
+    }
+  else if (m_retries % m_profile.kappa < m_profile.beta)
+    {
+      selected = m_profile.alpha + m_interruptions;
+      m_interruptions = 0;
+    }
+  else
+    {
+      selected = m_rng->GetInteger (0, m_profile.m);
+    }
+  m_selectedBackoff = selected;
+  m_attemptStart = Simulator::Now ();
+  m_attemptBusyUs = 0.0;
+  m_attemptEffectiveDataUs = 0.0;
+  m_attemptAccessDelayUs = 0.0;
+  m_attemptActive = true;
+  return selected;
+}
+
+void
+DbLbtLocalController::NotifyBusy (Time duration)
+{
+  NS_ABORT_MSG_IF (duration.IsNegative () || duration.IsZero (),
+                   "busy duration must be positive");
+  ++m_interruptions;
+  if (m_attemptActive)
+    {
+      m_attemptBusyUs += duration.GetMicroSeconds ();
+    }
+}
+
+void
+DbLbtLocalController::NotifyGrant (Time duration)
+{
+  NS_UNUSED (duration);
+  if (m_attemptActive)
+    {
+      m_attemptAccessDelayUs =
+        (Simulator::Now () - m_attemptStart).GetMicroSeconds ();
+    }
+}
+
+void
+DbLbtLocalController::NotifyOwnTx (Time duration)
+{
+  NS_ABORT_MSG_IF (duration.IsNegative () || duration.IsZero (),
+                   "own transmission duration must be positive");
+  if (m_attemptActive)
+    {
+      m_attemptEffectiveDataUs += duration.GetMicroSeconds ();
+    }
+}
+
+void
+DbLbtLocalController::NotifyArrival (uint32_t count)
+{
+  NS_ABORT_MSG_IF (count > std::numeric_limits<uint32_t>::max () -
+                             m_pendingArrivals,
+                   "local arrival counter overflow");
+  m_pendingArrivals += count;
+}
+
+void
+DbLbtLocalController::SetQueueOccupancy (double ratio)
+{
+  NS_ABORT_MSG_IF (!std::isfinite (ratio) || ratio < 0.0 || ratio > 1.0,
+                   "queue occupancy must be a finite ratio");
+  m_queueOccupancy = ratio;
+}
+
+void
+DbLbtLocalController::NotifyOutcome (bool success)
+{
+  if (!m_attemptActive)
+    {
+      return;
+    }
+  double elapsedUs =
+    (Simulator::Now () - m_lastAttemptEnd).GetMicroSeconds ();
+  NS_ABORT_MSG_IF (elapsedUs <= 0.0,
+                   "local attempt elapsed time must be positive");
+  AttemptRecord attempt;
+  attempt.success = success;
+  attempt.elapsedUs = elapsedUs;
+  attempt.busyUs = std::min (m_attemptBusyUs, elapsedUs);
+  attempt.interruptions = m_interruptions;
+  attempt.accessDelayUs = m_attemptAccessDelayUs;
+  attempt.queueOccupancy = m_queueOccupancy;
+  attempt.arrivals = m_pendingArrivals;
+  attempt.retries = success ? 0 : m_retries + 1;
+  attempt.effectiveDataUs =
+    std::min (m_attemptEffectiveDataUs, elapsedUs);
+  attempt.selectedBackoff = m_selectedBackoff;
+  RecordAttempt (attempt);
+  m_pendingArrivals = 0;
+  m_attemptBusyUs = 0.0;
+  m_attemptEffectiveDataUs = 0.0;
+  m_attemptAccessDelayUs = 0.0;
+  m_attemptActive = false;
+  m_lastAttemptEnd = Simulator::Now ();
+}
+
+void
+DbLbtLocalController::RecordAttempt (const AttemptRecord &attempt)
+{
+  NS_ABORT_MSG_IF (
+    !std::isfinite (attempt.elapsedUs) || attempt.elapsedUs <= 0.0 ||
+      !std::isfinite (attempt.busyUs) || attempt.busyUs < 0.0 ||
+      attempt.busyUs > attempt.elapsedUs ||
+      !std::isfinite (attempt.accessDelayUs) || attempt.accessDelayUs < 0.0 ||
+      !std::isfinite (attempt.queueOccupancy) ||
+      attempt.queueOccupancy < 0.0 || attempt.queueOccupancy > 1.0 ||
+      !std::isfinite (attempt.effectiveDataUs) ||
+      attempt.effectiveDataUs < 0.0 ||
+      attempt.effectiveDataUs > attempt.elapsedUs,
+    "invalid local DB-LBT attempt");
+
+  if (attempt.success)
+    {
+      m_initialized = true;
+      m_retries = 0;
+    }
+  else
+    {
+      ++m_retries;
+    }
+  ++m_attemptCount;
+  m_window.push_back (attempt);
+  if (m_window.size () > 64)
+    {
+      m_window.pop_front ();
+    }
+  m_interval.push_back (attempt);
+  m_attempts.push_back (attempt);
+  if (m_policy == Policy::Adaptive &&
+      m_attemptCount >= ColdStartAttempts &&
+      m_attemptCount % DecisionInterval == 0)
+    {
+      Decide ();
+    }
+}
+
+uint32_t
+DbLbtLocalController::GetAlpha () const
+{
+  return 11;
+}
+
+const std::string &
+DbLbtLocalController::GetStateId () const
+{
+  return m_stateId;
+}
+
+const DbLbtLocalController::RecoveryProfile &
+DbLbtLocalController::GetCurrentProfile () const
+{
+  return m_profile;
+}
+
+const std::vector<DbLbtLocalController::DecisionRecord> &
+DbLbtLocalController::GetDecisions () const
+{
+  return m_decisions;
+}
+
+const std::vector<DbLbtLocalController::AttemptRecord> &
+DbLbtLocalController::GetAttempts () const
+{
+  return m_attempts;
+}
+
+void
+DbLbtLocalController::LoadModel (
+  const std::string &modelPath,
+  const std::string &expectedModelHash,
+  const std::string &expectedGridHash)
+{
+  NS_ABORT_MSG_IF (expectedGridHash != g_gridHash,
+                   "unexpected DB-LBT action-grid hash");
+  std::ifstream input (modelPath);
+  NS_ABORT_MSG_IF (!input, "cannot open DB-LBT model " << modelPath);
+  try
+    {
+      RequireToken (input, "dblbt_ns3_model");
+      NS_ABORT_MSG_IF (ReadUint (input, "magic version") != 1,
+                       "unsupported DB-LBT model magic");
+      RequireToken (input, "schema_version");
+      NS_ABORT_MSG_IF (ReadUint (input, "schema version") != 1,
+                       "unsupported DB-LBT model schema");
+      RequireToken (input, "num_arms");
+      NS_ABORT_MSG_IF (ReadUint (input, "num arms") != NumArms,
+                       "DB-LBT model must contain 24 arms");
+      RequireToken (input, "context_dim");
+      NS_ABORT_MSG_IF (ReadUint (input, "context dim") != ContextDim,
+                       "DB-LBT model must contain 11 features");
+      RequireToken (input, "ridge");
+      NS_ABORT_MSG_IF (ReadDouble (input, "ridge") <= 0.0,
+                       "DB-LBT ridge must be positive");
+      RequireToken (input, "exploration");
+      m_exploration = ReadDouble (input, "exploration");
+      NS_ABORT_MSG_IF (m_exploration < 0.0,
+                       "DB-LBT exploration must be non-negative");
+      RequireToken (input, "action_grid_hash");
+      input >> m_gridHash;
+      NS_ABORT_MSG_IF (m_gridHash != expectedGridHash,
+                       "DB-LBT action-grid hash mismatch");
+      RequireToken (input, "source_model_sha256");
+      input >> m_modelHash;
+      NS_ABORT_MSG_IF (m_modelHash != expectedModelHash,
+                       "DB-LBT source model hash mismatch");
+      RequireToken (input, "profiles");
+      NS_ABORT_MSG_IF (ReadUint (input, "profile count") != NumArms,
+                       "DB-LBT profile count mismatch");
+      const auto profiles = Profiles ();
+      for (uint32_t arm = 0; arm < NumArms; ++arm)
+        {
+          RequireToken (input, "profile");
+          NS_ABORT_MSG_IF (ReadUint (input, "profile index") != arm,
+                           "DB-LBT profile order mismatch");
+          RecoveryProfile profile {
+            ReadUint (input, "kappa"),
+            ReadUint (input, "alpha"),
+            ReadUint (input, "beta"),
+            ReadUint (input, "m"),
+            ReadUint (input, "b_init")};
+          NS_ABORT_MSG_IF (!(profile == profiles.at (arm)),
+                           "DB-LBT profile grid mismatch");
+        }
+      RequireToken (input, "A_rows");
+      NS_ABORT_MSG_IF (ReadUint (input, "A rows") != NumArms * ContextDim,
+                       "DB-LBT A row count mismatch");
+      for (uint32_t arm = 0; arm < NumArms; ++arm)
+        {
+          for (uint32_t row = 0; row < ContextDim; ++row)
+            {
+              RequireToken (input, "A");
+              NS_ABORT_MSG_IF (ReadUint (input, "A arm") != arm ||
+                                 ReadUint (input, "A row") != row,
+                               "DB-LBT A row order mismatch");
+              for (double &value : m_model.at (arm).A.at (row))
+                {
+                  value = ReadDouble (input, "A value");
+                }
+            }
+        }
+      RequireToken (input, "b_rows");
+      NS_ABORT_MSG_IF (ReadUint (input, "b rows") != NumArms,
+                       "DB-LBT b row count mismatch");
+      for (uint32_t arm = 0; arm < NumArms; ++arm)
+        {
+          RequireToken (input, "b");
+          NS_ABORT_MSG_IF (ReadUint (input, "b arm") != arm,
+                           "DB-LBT b row order mismatch");
+          for (double &value : m_model.at (arm).b)
+            {
+              value = ReadDouble (input, "b value");
+            }
+          Context zero {};
+          Solve (m_model.at (arm).A, zero);
+        }
+      RequireToken (input, "end");
+      std::string extra;
+      NS_ABORT_MSG_IF (input >> extra, "DB-LBT model contains extra data");
+    }
+  catch (const std::exception &error)
+    {
+      NS_ABORT_MSG ("invalid DB-LBT model: " << error.what ());
+    }
+}
+
+void
+DbLbtLocalController::Decide ()
+{
+  Context context = BuildContext ();
+  double reward = IntervalReward (context);
+  if (m_currentArm >= 0)
+    {
+      UpdateArm (static_cast<uint32_t> (m_currentArm),
+                 m_decisionContext, reward);
+    }
+  uint32_t arm = SelectArm (context);
+  m_currentArm = static_cast<int32_t> (arm);
+  m_profile = Profiles ().at (arm);
+  m_decisionContext = context;
+  m_decisions.push_back ({m_attemptCount, arm, m_profile, context, reward});
+  m_interval.clear ();
+}
+
+DbLbtLocalController::Context
+DbLbtLocalController::BuildContext () const
+{
+  Context context {};
+  if (m_window.empty ())
+    {
+      return context;
+    }
+  double count = static_cast<double> (m_window.size ());
+  double collisions = 0.0;
+  double elapsed = 0.0;
+  double busy = 0.0;
+  double interruptions = 0.0;
+  double queue = 0.0;
+  double arrivals = 0.0;
+  double retries = 0.0;
+  double effective = 0.0;
+  std::vector<double> delays;
+  for (const auto &attempt : m_window)
+    {
+      collisions += attempt.success ? 0.0 : 1.0;
+      elapsed += attempt.elapsedUs;
+      busy += attempt.busyUs;
+      interruptions += attempt.interruptions;
+      queue += attempt.queueOccupancy;
+      arrivals += attempt.arrivals;
+      retries += attempt.retries;
+      effective += attempt.effectiveDataUs;
+      if (attempt.success)
+        {
+          delays.push_back (attempt.accessDelayUs);
+        }
+    }
+  double meanInterruptions = interruptions / count;
+  double contenders = std::min (std::max (1.0 + meanInterruptions, 1.0), 32.0);
+  double delayCapacity = 16000.0 * contenders;
+  double ewma = 0.0;
+  double p95 = 0.0;
+  if (!delays.empty ())
+    {
+      ewma = delays.front ();
+      for (size_t index = 1; index < delays.size (); ++index)
+        {
+          ewma = 0.8 * ewma + 0.2 * delays.at (index);
+        }
+      std::sort (delays.begin (), delays.end ());
+      size_t rank = static_cast<size_t> (std::ceil (0.95 * delays.size ())) - 1;
+      p95 = delays.at (rank);
+    }
+  double meanRetries = retries / count;
+  context = {
+    Clip (collisions / count),
+    Clip ((count - collisions) / count),
+    Clip (busy / elapsed),
+    Clip (meanInterruptions / 31.0),
+    Clip (ewma / delayCapacity),
+    Clip (p95 / delayCapacity),
+    Clip (queue / count),
+    Clip (arrivals / (elapsed / 1000.0) / 0.1),
+    Clip (meanRetries / (1.0 + meanRetries)),
+    Clip (effective / elapsed),
+    Clip ((contenders - 1.0) / 31.0)};
+  return context;
+}
+
+double
+DbLbtLocalController::IntervalReward (const Context &context) const
+{
+  if (m_interval.empty ())
+    {
+      return 0.0;
+    }
+  double elapsed = 0.0;
+  double effective = 0.0;
+  double otherBusy = 0.0;
+  double collisions = 0.0;
+  std::vector<double> delays;
+  for (const auto &attempt : m_interval)
+    {
+      elapsed += attempt.elapsedUs;
+      effective += attempt.effectiveDataUs;
+      otherBusy += attempt.busyUs;
+      collisions += attempt.success ? 0.0 : 1.0;
+      if (attempt.success)
+        {
+          delays.push_back (attempt.accessDelayUs);
+        }
+    }
+  double p95 = 0.0;
+  if (!delays.empty ())
+    {
+      std::sort (delays.begin (), delays.end ());
+      size_t rank = static_cast<size_t> (std::ceil (0.95 * delays.size ())) - 1;
+      p95 = delays.at (rank);
+    }
+  double contenders = context.at (10) * 31.0 + 1.0;
+  double airtimeUtility = Clip (contenders * effective / elapsed);
+  double delayUtility = 1.0 - Clip (p95 / (16000.0 * contenders));
+  double denominator = effective + otherBusy;
+  double localShare = denominator > 0.0 ? effective / denominator : 0.0;
+  double targetShare = 1.0 / contenders;
+  double shareUtility =
+    1.0 - Clip (std::abs (localShare - targetShare) / targetShare);
+  double collisionProbability = collisions / m_interval.size ();
+  return (airtimeUtility + delayUtility + shareUtility) / 3.0 -
+         0.25 * collisionProbability;
+}
+
+uint32_t
+DbLbtLocalController::SelectArm (const Context &context) const
+{
+  uint32_t bestArm = 0;
+  double bestScore = -std::numeric_limits<double>::infinity ();
+  for (uint32_t arm = 0; arm < NumArms; ++arm)
+    {
+      Context estimate = Solve (m_model.at (arm).A, m_model.at (arm).b);
+      Context uncertainty = Solve (m_model.at (arm).A, context);
+      double exploitation = 0.0;
+      double variance = 0.0;
+      for (uint32_t index = 0; index < ContextDim; ++index)
+        {
+          exploitation += estimate.at (index) * context.at (index);
+          variance += context.at (index) * uncertainty.at (index);
+        }
+      double score = exploitation +
+                     m_exploration * std::sqrt (std::max (variance, 0.0));
+      NS_ABORT_MSG_IF (!std::isfinite (score), "non-finite DB-LBT score");
+      if (score > bestScore)
+        {
+          bestScore = score;
+          bestArm = arm;
+        }
+    }
+  return bestArm;
+}
+
+void
+DbLbtLocalController::UpdateArm (uint32_t arm,
+                                 const Context &context,
+                                 double reward)
+{
+  for (uint32_t row = 0; row < ContextDim; ++row)
+    {
+      for (uint32_t column = 0; column < ContextDim; ++column)
+        {
+          m_model.at (arm).A.at (row).at (column) +=
+            context.at (row) * context.at (column);
+        }
+      m_model.at (arm).b.at (row) += reward * context.at (row);
+    }
+}
+
+DbLbtLocalController::Context
+DbLbtLocalController::Solve (const Matrix &matrix,
+                             const Context &rightHandSide)
+{
+  Matrix lower {};
+  for (uint32_t row = 0; row < ContextDim; ++row)
+    {
+      for (uint32_t column = 0; column <= row; ++column)
+        {
+          double sum = matrix.at (row).at (column);
+          for (uint32_t k = 0; k < column; ++k)
+            {
+              sum -= lower.at (row).at (k) * lower.at (column).at (k);
+            }
+          if (row == column)
+            {
+              if (!(sum > 0.0) || !std::isfinite (sum))
+                {
+                  throw std::runtime_error ("model A is not positive definite");
+                }
+              lower.at (row).at (column) = std::sqrt (sum);
+            }
+          else
+            {
+              lower.at (row).at (column) =
+                sum / lower.at (column).at (column);
+            }
+        }
+    }
+  Context intermediate {};
+  for (uint32_t row = 0; row < ContextDim; ++row)
+    {
+      double sum = rightHandSide.at (row);
+      for (uint32_t column = 0; column < row; ++column)
+        {
+          sum -= lower.at (row).at (column) * intermediate.at (column);
+        }
+      intermediate.at (row) = sum / lower.at (row).at (row);
+    }
+  Context result {};
+  for (int32_t row = ContextDim - 1; row >= 0; --row)
+    {
+      double sum = intermediate.at (static_cast<size_t> (row));
+      for (uint32_t column = static_cast<uint32_t> (row + 1);
+           column < ContextDim;
+           ++column)
+        {
+          sum -= lower.at (column).at (static_cast<size_t> (row)) *
+                 result.at (column);
+        }
+      result.at (static_cast<size_t> (row)) =
+        sum / lower.at (static_cast<size_t> (row)).at (static_cast<size_t> (row));
+    }
+  return result;
+}
+
+double
+DbLbtLocalController::Clip (double value)
+{
+  return std::min (std::max (value, 0.0), 1.0);
+}
+
+} // namespace ns3
